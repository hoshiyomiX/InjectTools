<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme using Material 3 -->
    <style name="Theme.InjectTools" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="android:colorPrimary">@color/md_theme_light_primary</item>
        <item name="android:colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="android:colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="android:colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        
        <!-- Secondary brand color -->
        <item name="android:colorSecondary">@color/md_theme_light_secondary</item>
        <item name="android:colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="android:colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="android:colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        
        <!-- Tertiary brand color -->
        <item name="android:colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="android:colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="android:colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="android:colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>
        
        <!-- Error color -->
        <item name="android:colorError">@color/md_theme_light_error</item>
        <item name="android:colorOnError">@color/md_theme_light_onError</item>
        <item name="android:colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="android:colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>
        
        <!-- Background and Surface -->
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="android:colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="android:colorSurface">@color/md_theme_light_surface</item>
        <item name="android:colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="android:colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="android:colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/md_theme_light_primary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
